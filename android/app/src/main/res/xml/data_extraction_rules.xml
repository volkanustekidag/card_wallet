<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-to-device transfer rules.
  Card wallets must never leave the device: card metadata, PIN hashes,
  Hive encryption keys and biometric flags all live in app storage and
  cannot be safely restored to a different device or account.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
