+Future<void> _openShot(String shot) async {
+  final loyalty = await LoyaltyCardService().getAllLoyaltyCards();
+  final credit = await CreditCardService().getAllCreditCards();
+  final ibans = await IbanCardService().getAllIbanCards();
+  switch (shot) {
+    case 'checkout':
+      Get.to(() => LoyaltyCardDetailPage(card: loyalty.firstWhere((c) => c.id == 's-coffee')));
+      break;
+    case 'bank':
+      Get.to(() => BankCardPage(card: credit.firstWhere((c) => c.id == 's-everyday')));
+      break;
+    case 'iban':
+      Get.to(() => IbanPage(card: ibans.first));
+      await Future<void>.delayed(const Duration(milliseconds: 900));
+      final ctx = Get.context;
+      if (ctx != null) unawaited(showIbanShareSheet(ctx, isPremium: true, card: ibans.first));
+      break;
+    case 'confirm':
+      Get.to(() => const Scaffold(backgroundColor: Color(0xFF0B0C0F), body: _ShotScannerBackdrop()));
+      await Future<void>.delayed(const Duration(milliseconds: 700));
+      final ctx = Get.context;
+      if (ctx != null) {
+        unawaited(showLoyaltyConfirmSheet(ctx, raw: '4006381333931', format: 'EAN_13',
+            brand: BrandEntry(name: _confirmBrand.$1, domain: 'confirm.invalid', color: _confirmBrand.$2, regions: const ['global'])));
+      }
+      break;
+  }
+}
