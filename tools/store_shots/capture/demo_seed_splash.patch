+Future<void> _seedMarket(String m) async {
+  final cc = CreditCardService();
+  final ib = IbanCardService();
+  final lc = LoyaltyCardService();
+  await cc.openBox(); await ib.openBox(); await lc.openBox();
+  await cc.deleteAllData(); await ib.deleteAllData(); await lc.deleteAllData();
+  final now = DateTime.now();
+  final d = _markets[m]!;
+  _confirmBrand = d['confirm'] as (String, int);
+  final holder = d['holder'] as String;
+  final bank = d['bank'] as List<String>;
+  await cc.addToCreditCard(CreditCard(id: 's-everyday', bankName: bank[0], creditCardNumber: '4242 4242 4242 4242',
+      cardHolder: holder.toUpperCase(), expirationDate: '09/28', cardColorId: 11, createdAt: now,
+      paymentDueDay: (now.day + 2) % 28 + 1, paymentReminderEnabled: true, expiryReminderEnabled: true));
+  await cc.addToCreditCard(CreditCard(id: 's-gold', bankName: bank[1], creditCardNumber: d['second'] as String,
+      cardHolder: holder.toUpperCase(), expirationDate: '02/29', cardColorId: 12, createdAt: now.subtract(const Duration(days: 3))));
+  final iban = d['iban'] as List<String>?;
+  if (iban != null) {
+    await ib.addIbanCard(IbanCard(id: 's-iban', bankName: iban[0], cardHolder: holder,
+        iban: iban[1], swiftCode: iban[2], createdAt: now.subtract(const Duration(days: 1))));
+  }
+  final cards = d['cards'] as List<List<Object>>;
+  final ids = ['s-coffee', 's-grocer', 's-beauty', 's-books', 's-gym'];
+  final codes = [['6061234567890123', 'QR_CODE'], ['5012345678900', 'EAN_13'], ['3000001234562', 'EAN_13'], ['9780201379624', 'EAN_13'], ['4006381333931', 'EAN_13']];
+  final usesList = [18, 9, 4, 2, 1];
+  for (var i = 0; i < cards.length; i++) {
+    final uses = usesList[i];
+    final log = [for (var k = 0; k < uses; k++) now.subtract(Duration(days: k + 1, minutes: (k * 13) % 40)).millisecondsSinceEpoch].reversed.toList();
+    await lc.addLoyaltyCard(LoyaltyCard(id: ids[i], name: cards[i][0] as String, barcode: codes[i][0],
+        barcodeFormat: codes[i][1], colorId: 0, brandColor: cards[i][1] as int, createdAt: now,
+        useCount: uses, lastUsedAt: DateTime.fromMillisecondsSinceEpoch(log.last), usageLog: log,
+        website: 'shot-${ids[i]}.invalid'));
   }
 }
