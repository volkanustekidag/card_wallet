# Dart obfuscation symbol output from tools/release_build.sh.
# These MUST be retained outside the repo (private storage tagged with
# the release version) — without them, obfuscated Crashlytics stack
# traces from production cannot be decoded.
symbols/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.dart_defines/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/lib/core/constants/keys.dart

# Symbolication related
app.*.symbols

