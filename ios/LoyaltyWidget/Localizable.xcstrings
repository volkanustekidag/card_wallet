    "Quickly show your most recent loyalty card barcode.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son açtığın sadakat kartının barkodunu hızlıca göster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeige schnell den Barcode deiner zuletzt genutzten Bonuskarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez rapidement le code-barres de votre dernière carte de fidélité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra rápidamente el código de barras de tu última tarjeta de fidelidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre rapidamente o código de barras do seu último cartão de fidelidade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra rapidamente il codice a barre della tua ultima carta fedeltà."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon snel de barcode van je laatst gebruikte klantenkaart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybko pokaż kod kreskowy ostatnio używanej karty lojalnościowej."
          }
        }
      }
    },
